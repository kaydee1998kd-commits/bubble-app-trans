name: BubbleTranslate
options:
  bundleIdPrefix: com.bubbletranslate
  deploymentTarget:
    iOS: "15.0"

targets:
  BubbleTranslate:
    type: application
    platform: iOS
    deploymentTarget:
      iOS: "15.0"
    sources:
      - Sources
      - Resources
    dependencies:
      - sdk: Vision.framework
      - sdk: AVFoundation.framework
    settings:
      base:
        PRODUCT_BUNDLE_IDENTIFIER: com.bubbletranslate.app
        PRODUCT_NAME: BubbleTranslate
        INFOPLIST_FILE: Info.plist
        CODE_SIGN_IDENTITY: ""
        CODE_SIGNING_REQUIRED: NO
        CODE_SIGNING_ALLOWED: NO
        DEVELOPMENT_TEAM: ""
        ENABLE_BITCODE: NO
        SWIFT_VERSION: "5.0"
        TARGETED_DEVICE_FAMILY: "1"
        IPHONEOS_DEPLOYMENT_TARGET: "15.0"
        ASSETCATALOG_COMPILER_APPICON_NAME: AppIcon
